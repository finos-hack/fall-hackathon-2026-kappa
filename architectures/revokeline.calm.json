{
  "$schema": "https://calm.finos.org/release/1.3/meta/calm.json",
  "metadata": {
    "version": "0.2.7",
    "description": "Logical dependency architecture for the local synthetic incident demo. Connections describe business dependencies, not necessarily separate network services. No claim of production security or TLS."
  },
  "nodes": [
    {
      "unique-id": "security-alert",
      "node-type": "actor",
      "name": "Security incident feed",
      "description": "Synthetic incident event source"
    },
    {
      "unique-id": "fluxnova-kyc-process",
      "node-type": "service",
      "name": "Fluxnova KYC orchestration",
      "description": "FINOS Fluxnova 2.0.0 executable BPMN; Python external-task bridge performs authorization and completes tasks. Local REST endpoint on port 8080.",
      "interfaces": [
        {
          "unique-id": "workflow-api",
          "protocol": "HTTP",
          "host": "127.0.0.1",
          "port": 8080
        }
      ]
    },
    {
      "unique-id": "revokeline-gateway",
      "node-type": "service",
      "name": "REVOKELINE gateway",
      "description": "FastAPI request-time enforcement and synthetic revocation; local HTTP only.",
      "interfaces": [
        {
          "unique-id": "gateway-api",
          "protocol": "HTTP",
          "host": "127.0.0.1",
          "port": 8000
        }
      ]
    },
    {
      "unique-id": "external-kyc-provider",
      "node-type": "service",
      "name": "Synthetic KYC provider",
      "description": "Simulated document verification result inside FastAPI, not a remote service.",
      "interfaces": [
        {
          "unique-id": "provider-api",
          "description": "Logical simulated provider interface; no network endpoint"
        }
      ]
    },
    {
      "unique-id": "secondary-kyc-provider",
      "node-type": "service",
      "name": "Secondary synthetic KYC provider",
      "description": "Independent simulated verification provider; no remote service.",
      "interfaces": [
        {
          "unique-id": "secondary-provider-api",
          "description": "Logical simulated provider interface; no network endpoint"
        }
      ]
    },
    {
      "unique-id": "human-review",
      "node-type": "service",
      "name": "Fluxnova analyst review",
      "description": "Real BPMN user task human_review, hosted by the same Fluxnova engine.",
      "interfaces": [
        {
          "unique-id": "review-api",
          "description": "Logical user-task interface within Fluxnova"
        }
      ]
    },
    {
      "unique-id": "evidence-store",
      "node-type": "database",
      "name": "In-memory evidence log",
      "description": "Hash-chained events inside FastAPI memory; not durable or independently anchored.",
      "interfaces": [
        {
          "unique-id": "evidence-api",
          "description": "Logical in-process evidence interface"
        }
      ]
    }
  ],
  "relationships": [
    {
      "unique-id": "alert-to-gateway",
      "description": "Security alerts reach the governance adapter",
      "relationship-type": {
        "interacts": {
          "actor": "security-alert",
          "nodes": [
            "revokeline-gateway"
          ]
        }
      }
    },
    {
      "unique-id": "workflow-to-gateway",
      "description": "Logical dependency: the Python external-task bridge reads Fluxnova process variables and calls FastAPI for request-time enforcement.",
      "relationship-type": {
        "connects": {
          "source": {
            "node": "fluxnova-kyc-process",
            "interfaces": [
              "workflow-api"
            ]
          },
          "destination": {
            "node": "revokeline-gateway",
            "interfaces": [
              "gateway-api"
            ]
          }
        }
      }
    },
    {
      "unique-id": "gateway-to-provider",
      "description": "Logical call to a simulated verification operation, not a remote provider API.",
      "relationship-type": {
        "connects": {
          "source": {
            "node": "revokeline-gateway",
            "interfaces": [
              "gateway-api"
            ]
          },
          "destination": {
            "node": "external-kyc-provider",
            "interfaces": [
              "provider-api"
            ]
          }
        }
      }
    },
    {
      "unique-id": "workflow-to-review",
      "description": "On DENY the real BPMN process creates its human_review user task in Fluxnova.",
      "relationship-type": {
        "connects": {
          "source": {
            "node": "fluxnova-kyc-process",
            "interfaces": [
              "workflow-api"
            ]
          },
          "destination": {
            "node": "human-review",
            "interfaces": [
              "review-api"
            ]
          }
        }
      }
    },
    {
      "unique-id": "gateway-to-evidence",
      "description": "Authorization decisions append to the in-process evidence log.",
      "relationship-type": {
        "connects": {
          "source": {
            "node": "revokeline-gateway",
            "interfaces": [
              "gateway-api"
            ]
          },
          "destination": {
            "node": "evidence-store",
            "interfaces": [
              "evidence-api"
            ]
          }
        }
      }
    },
    {
      "unique-id": "gateway-to-secondary-provider",
      "description": "Logical connection to the second simulated provider.",
      "relationship-type": {
        "connects": {
          "source": {
            "node": "revokeline-gateway",
            "interfaces": [
              "gateway-api"
            ]
          },
          "destination": {
            "node": "secondary-kyc-provider",
            "interfaces": [
              "secondary-provider-api"
            ]
          }
        }
      }
    }
  ]
}
